# ==============================================================================
# BloodLink Official Email Dispatcher Environment Configuration
# ==============================================================================

# Official BloodLink Sender Email (Google Account)
EMAIL_USER=bloodlink112@gmail.com

# Google 16-character App Password (Generate at https://myaccount.google.com/apppasswords)
# Do NOT put your regular Gmail password here. Use the 16-letter App Password.
EMAIL_APP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD

# Development / Testing Mode
# When true, emails can be routed to EMAIL_TEST_RECIPIENT instead of mock donors
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=bloodlink112@gmail.com

# Express Backend Port (for standalone server)
PORT=5000
